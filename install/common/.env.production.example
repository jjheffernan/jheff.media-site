# Production environment — copy to install/common/.env.production or scripts/.env.production
# Do not commit real secrets. Keep this file chmod 600 (owner: jheffmedia on install hosts).
# There is no /root/site-install.creds — this file is the single secrets store for Compose.

# HTTP
HTTP_PORT=8080
# Host publish address (Docker port publish). Use 127.0.0.1 only when a reverse proxy
# on the same LXC terminates TLS. The app always binds 0.0.0.0 *inside* the container.
HTTP_BIND=0.0.0.0

# MongoDB (bundled db service)
MONGO_PASSWORD=change-me
DB_NAME=jheffmedia
DB_CONNSTR=mongodb://root:change-me@db:27017/jheffmedia?authSource=admin

# JWT — generate once per environment (mounted at container start, not baked into image):
#   openssl rand -out backend/src/secret.key 32
# Or set hex secret instead of file mount:
#   YEW_FULLSTACK_JWT_SECRET=<64 hex chars from: openssl rand -hex 32>

# Photo feed — Immich (recommended for production homepage)
FEED_PROVIDER=immich
IMMICH_URL=https://immich.internal.example.com
IMMICH_API_KEY=your-api-key-here
IMMICH_ALBUM_ID=album-uuid-for-homepage-feed
# IMMICH_SHARED_KEY=

# Dev/demo without Immich:
# FEED_PROVIDER=static
# FEED_STATIC_JSON=[{"id":"1","thumbnailUrl":"https://picsum.photos/seed/a/800/600","title":"Sample"}]

# Optional
# CONTACT_EMAIL=
# ADMIN_EMAILS=you@example.com

# Release identity (short git SHA). Install/`jheffmedia --update` set this automatically.
# Empty at runtime → Admin → Dev warning NO_BUILD_ID. Must live in this file so systemd
# compose restarts do not override the image ENV with an empty string.
# YEW_FULLSTACK_BUILD_ID=

# Browser CORS origins, comma-separated (no spaces required). Install sets from PUBLIC_URL
# or http://<host-ip>:HTTP_PORT when unset. Do not leave blank in production (CORS_DEFAULT).
# Examples: https://jheff.media   or   https://jheff.media,http://192.168.1.10:8080
# YEW_FULLSTACK_CORS_ORIGINS=https://jheff.media
# PUBLIC_URL=https://jheff.media
