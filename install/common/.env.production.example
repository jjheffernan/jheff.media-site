# Production environment — copy to install/common/.env.production or scripts/.env.production
# Do not commit real secrets.

# HTTP
HTTP_PORT=8080
HOST=0.0.0.0
PORT=8080

# MongoDB (bundled db service)
MONGO_PASSWORD=change-me
DB_NAME=jheffmedia
DB_CONNSTR=mongodb://root:change-me@db:27017/jheffmedia?authSource=admin

# JWT — generate once per environment (mounted at container start, not baked into image):
#   openssl rand -out backend/src/secret.key 32
# Or set hex secret instead of file mount:
#   YEW_FULLSTACK_JWT_SECRET=<64 hex chars from: openssl rand -hex 32>

# Photo feed — Immich (recommended for production homepage)
FEED_PROVIDER=immich
IMMICH_URL=https://immich.internal.example.com
IMMICH_API_KEY=your-api-key-here
IMMICH_ALBUM_ID=album-uuid-for-homepage-feed
# IMMICH_SHARED_KEY=

# Dev/demo without Immich:
# FEED_PROVIDER=static
# FEED_STATIC_JSON=[{"id":"1","thumbnailUrl":"https://picsum.photos/seed/a/800/600","title":"Sample"}]

# Optional
# CONTACT_EMAIL=
# ADMIN_EMAILS=you@example.com
