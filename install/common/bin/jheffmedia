#!/usr/bin/env bash
# Host CLI for a deployed jheff.media install.
#   jheffmedia --update [-d|--dev] | --status | --restart | --postinstall
#   jheffmedia --cleanup | --reinstall | --autoupdate …
#   jheffmedia -h | --help
#
# Operator model: install (apt/docker/pct) needs root. Day-2 ops run as root or
# the jheffmedia service user (docker group). App containers themselves are non-root.

set -euo pipefail

INSTALL_DIR="${INSTALL_DIR:-/opt/jheffmedia-site}"
BRANCH="${BRANCH:-main}"
COMPOSE_DIR="${INSTALL_DIR}/install/common"
COMMON_DIR="${COMPOSE_DIR}"
ENV_FILE="${COMPOSE_DIR}/.env.production"
AUTOUPDATE_ENV="${COMPOSE_DIR}/autoupdate.env"
POSTINSTALL="${INSTALL_DIR}/install/postinstall.sh"
SERVICE_USER="${SERVICE_USER:-jheffmedia}"
SERVICE_UID="${SERVICE_UID:-10001}"
# Channels: main = production; testing = non-prod (-d / --dev / --testing).
CHANNEL_PROD=main
CHANNEL_DEV=testing

usage() {
  cat <<'EOF'
jheffmedia — manage a deployed jheff.media site

Usage:
  jheffmedia --update [-d|--dev|--testing] [--channel NAME] [--branch BRANCH] [--no-cache]
      Pull, rebuild image, restart stack (healthy installs).
      Plain --update always tracks production (main).
      -d, --dev, --testing   Deploy from testing branch
      --channel NAME         main (prod) or testing (same as -d)
      --branch BRANCH        Explicit git branch (escape hatch)
      --no-cache             Rebuild without Docker layer cache (avoid unless needed)
  jheffmedia --autoupdate enable|disable|status [-d|--dev|--testing] [--channel NAME] [--interval daily|weekly]
      Optional systemd timer (off by default). enable is idempotent; needs root.
      Channel is stored in install/common/autoupdate.env (AUTOUPDATE_CHANNEL).
  jheffmedia --cleanup [--dry-run] [-y|--yes]
      Safe repair: drop legacy cred dumps, ensure service user, fix ownership /
      secret perms, refresh site.service User=, prune exited jheffmedia
      containers. Does NOT delete Mongo volumes or .env.production.
      --dry-run              Print actions only
      -y, --yes              Skip confirm for project docker prune
  jheffmedia --reinstall [--purge] [-d|--dev|--testing] [--branch BRANCH] [--no-cache] [-y|--yes]
      Cleanup, then pull/rebuild/restart like --update (for broken/partial
      installs). Keeps DB volumes by default.
      --purge                Remove this project's containers + app image first;
                            still confirms before deleting named volumes
      -y, --yes              Skip non-volume confirms (volumes always confirm unless
                            JM_PURGE_VOLUMES=yes)
  jheffmedia --status
  jheffmedia --diagnostics
      Container + /healthz + Mongo auth ping (no secrets printed).
  jheffmedia --reset-db [-y|--yes]
      Wipe Mongo data volume only (users/schedule/site_config). Keeps
      uploads + .env.production. Recreates DB with current MONGO_PASSWORD.
      -y, --yes still requires typing RESET unless JM_RESET_DB=yes.
  jheffmedia --restart
  jheffmedia --postinstall [--show-creds]
      Admin signup reminder (ADMIN_EMAILS → Admin → Setup).
      --show-creds prints admin email + secret *paths* (not Mongo/JWT values).
  jheffmedia -h, --help
      This usage (also printed for bare `jheffmedia`).

When to use what:
  --cleanup       leaks / wrong owner / leftover /root/*.creds / bad User=
  --reinstall     partial or broken install; refresh stack, keep data
  --reset-db      Mongo password mismatch or wipe users; keep media uploads
  --update        routine pull on production (main)
  --update -d     pull from testing channel (--dev / --testing also ok)
  --autoupdate    optional periodic --update (off by default)
  --diagnostics   site/container health before opening a ticket

Privilege:
  --update / --restart / --cleanup / --reinstall / --reset-db / --diagnostics
  / --autoupdate enable|disable need root or docker-group (service user
  jheffmedia). Unit install needs root. --autoupdate status is read-only.
  --status / --postinstall need read access to the install tree.
  First-time install (Docker engine, LXC create) still requires root.

Env:
  INSTALL_DIR    Install path (default /opt/jheffmedia-site)
  BRANCH         Default branch for install scripts (CLI --update ignores this;
                 plain --update always uses main unless -d/--branch)
  SERVICE_USER   Host operator user (default jheffmedia)
  SERVICE_UID    Host/container uid (default 10001)
  JM_PURGE_VOLUMES  Set to yes with --reinstall --purge --yes to also
                    delete jheffmedia-mongo / jheffmedia-content-uploads
  JM_RESET_DB       Set to yes to allow --reset-db --yes without typing RESET
EOF
}

# Map channel name → git branch. Unknown names fail closed.
resolve_channel() {
  case "$1" in
    main | prod | production) echo "$CHANNEL_PROD" ;;
    testing | dev) echo "$CHANNEL_DEV" ;;
    *)
      echo "Unknown channel: $1 (main|testing)" >&2
      return 1
      ;;
  esac
}

# docker group ≈ root on the host — still better than running the *app* as root.
require_operator() {
  if [[ ${EUID:-0} -eq 0 ]]; then
    return 0
  fi
  if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    return 0
  fi
  echo "Run as root or a user in the docker group (e.g. ${SERVICE_USER})." >&2
  exit 1
}

require_install() {
  if [[ ! -d "${INSTALL_DIR}/.git" || ! -f "$ENV_FILE" ]]; then
    echo "No install at ${INSTALL_DIR} (missing .git or .env.production)." >&2
    exit 1
  fi
}

# Softer than require_install — tree may be partial.
require_install_tree() {
  if [[ ! -d "$INSTALL_DIR" ]]; then
    echo "No install directory at ${INSTALL_DIR}." >&2
    exit 1
  fi
}

load_env() {
  # shellcheck disable=SC1091
  set -a
  source "$ENV_FILE"
  set +a
  export HTTP_PORT="${HTTP_PORT:-8080}"
  export HTTP_BIND="${HTTP_BIND:-0.0.0.0}"
}

container_bin() {
  # shellcheck disable=SC1091
  source "${INSTALL_DIR}/scripts/lib/container.sh"
  require_container
}

source_deploy() {
  export INSTALL_DIR COMMON_DIR SERVICE_USER SERVICE_UID
  # shellcheck disable=SC1091
  source "${COMPOSE_DIR}/lib/deploy.sh"
}

confirm() {
  local prompt=$1
  local ans
  if [[ "${ASSUME_YES:-0}" -eq 1 ]]; then
    return 0
  fi
  read -r -p "${prompt} [y/N] " ans || true
  [[ "${ans}" =~ ^[Yy]$ ]]
}

# Always ask for volume wipe unless JM_PURGE_VOLUMES=yes (even with --yes).
confirm_volumes() {
  local prompt=$1
  local ans
  if [[ "${JM_PURGE_VOLUMES:-}" == "yes" ]]; then
    return 0
  fi
  read -r -p "${prompt} [y/N] " ans || true
  [[ "${ans}" =~ ^[Yy]$ ]]
}

report() {
  local kind=$1
  shift
  case "$kind" in
    fixed) echo "[fixed] $*" ;;
    skip) echo "[skip]  $*" ;;
    would) echo "[would] $*" ;;
    *) echo "[..] $*" ;;
  esac
}

cmd_update() {
  local no_cache=0
  # Safer UX: plain --update always tracks production main (ignore $BRANCH env).
  BRANCH="$CHANNEL_PROD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      --branch) BRANCH="${2:?}"; shift 2 ;;
      --branch=*) BRANCH="${1#*=}"; shift ;;
      -d | --dev | --testing) BRANCH="$CHANNEL_DEV"; shift ;;
      --channel)
        BRANCH="$(resolve_channel "${2:?}")" || exit 1
        shift 2
        ;;
      --channel=*)
        BRANCH="$(resolve_channel "${1#*=}")" || exit 1
        shift
        ;;
      --no-cache) no_cache=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done

  require_operator
  require_install
  container_bin
  load_env
  source_deploy

  echo "[..] Pulling ${BRANCH} in ${INSTALL_DIR}"
  install_git fetch origin "$BRANCH"
  install_git checkout "$BRANCH"
  install_git pull --ff-only origin "$BRANCH"
  # Symlink refresh needs root; skip when running as service user.
  if [[ ${EUID:-0} -eq 0 && -x "${COMPOSE_DIR}/bin/jheffmedia" ]]; then
    ln -sfn "${COMPOSE_DIR}/bin/jheffmedia" /usr/local/bin/jheffmedia
    printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/jheffmedia --update "$@"' >/usr/local/bin/site-update
    chmod +x /usr/local/bin/site-update "${COMPOSE_DIR}/bin/jheffmedia" \
      "${COMPOSE_DIR}/bin/jheffmedia-gui-update" 2>/dev/null || true
  fi
  echo "[OK] Repository updated"

  echo "[..] Rebuilding application image (may take several minutes)"
  cd "$COMPOSE_DIR"
  if [[ "$no_cache" -eq 1 ]]; then
    compose_build --no-cache
  else
    compose_build
  fi
  echo "[OK] Image built"
  echo "[..] Starting stack"
  export_build_id
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production up -d --remove-orphans
  if [[ ${EUID:-0} -eq 0 ]]; then
    # Refresh site.service (User=jheffmedia) and drop legacy /root/*.creds.
    ensure_service_user
    install_systemd
    harden_install_perms
    remove_legacy_creds_file
  elif declare -F install_gui_deploy >/dev/null 2>&1; then
    # Service user: still refresh deploy control dir perms when possible.
    mkdir -p "${INSTALL_DIR}/var/deploy" 2>/dev/null || true
  fi
  # Channel hint for Admin → Dev deploy panel (bind-mounted).
  mkdir -p "${INSTALL_DIR}/var/deploy" 2>/dev/null || true
  echo "${BRANCH}" >"${INSTALL_DIR}/var/deploy/channel-hint" 2>/dev/null || true
  echo "${BRANCH}" >"${COMPOSE_DIR}/.install-version"
  echo "[OK] Stack updated (${BRANCH}) — http://127.0.0.1:${HTTP_PORT}/"
}

# ponytail: one timer + EnvironmentFile; no fleet manager.
cmd_autoupdate() {
  local action="${1:-status}"
  shift || true
  local channel="$CHANNEL_PROD" interval=daily
  local unit_svc=/etc/systemd/system/jheffmedia-autoupdate.service
  local unit_tmr=/etc/systemd/system/jheffmedia-autoupdate.timer
  local calendar cli

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      -d | --dev | --testing) channel="$CHANNEL_DEV"; shift ;;
      --channel)
        channel="$(resolve_channel "${2:?}")" || exit 1
        shift 2
        ;;
      --channel=*)
        channel="$(resolve_channel "${1#*=}")" || exit 1
        shift
        ;;
      --interval)
        interval="${2:?}"
        shift 2
        ;;
      --interval=*)
        interval="${1#*=}"
        shift
        ;;
      *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done

  case "$interval" in
    daily) calendar="*-*-* 04:00:00" ;;
    weekly) calendar="Mon *-*-* 04:00:00" ;;
    *)
      echo "Unknown interval: ${interval} (daily|weekly)" >&2
      exit 1
      ;;
  esac

  case "$action" in
    enable)
      if [[ ${EUID:-0} -ne 0 ]]; then
        echo "jheffmedia --autoupdate enable needs root." >&2
        exit 1
      fi
      require_install
      cli="$(command -v jheffmedia || true)"
      [[ -x "$cli" ]] || cli=/usr/local/bin/jheffmedia
      if [[ ! -x "$cli" ]]; then
        echo "jheffmedia not on PATH; run --update once as root first." >&2
        exit 1
      fi
      mkdir -p "$COMPOSE_DIR"
      cat >"$AUTOUPDATE_ENV" <<EOF
# Written by jheffmedia --autoupdate enable. Channel: main | testing
AUTOUPDATE_CHANNEL=${channel}
EOF
      chmod 644 "$AUTOUPDATE_ENV"
      cat >"$unit_svc" <<EOF
[Unit]
Description=jheff.media autoupdate
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-${AUTOUPDATE_ENV}
# Map channel → CLI flags; plain --update = main.
ExecStart=/bin/bash -c 'ch="\${AUTOUPDATE_CHANNEL:-main}"; if [ "\$ch" = "testing" ] || [ "\$ch" = "dev" ]; then exec ${cli} --update -d; else exec ${cli} --update; fi'
Nice=10
EOF
      cat >"$unit_tmr" <<EOF
[Unit]
Description=jheff.media autoupdate timer

[Timer]
OnCalendar=${calendar}
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
EOF
      systemctl daemon-reload
      systemctl enable --now jheffmedia-autoupdate.timer
      mkdir -p "${INSTALL_DIR}/var/deploy" 2>/dev/null || true
      printf 'enabled=1\nchannel=%s\ninterval=%s\n' "$channel" "$interval" \
        >"${INSTALL_DIR}/var/deploy/autoupdate-status" 2>/dev/null || true
      echo "[OK] Autoupdate enabled (channel=${channel}, interval=${interval})"
      echo "     Logs: journalctl -u jheffmedia-autoupdate.service -n 50"
      ;;
    disable)
      if [[ ${EUID:-0} -ne 0 ]]; then
        echo "jheffmedia --autoupdate disable needs root." >&2
        exit 1
      fi
      systemctl disable --now jheffmedia-autoupdate.timer 2>/dev/null || true
      mkdir -p "${INSTALL_DIR}/var/deploy" 2>/dev/null || true
      printf 'enabled=0\nchannel=\n' >"${INSTALL_DIR}/var/deploy/autoupdate-status" 2>/dev/null || true
      echo "[OK] Autoupdate disabled (units left on disk; re-enable anytime)"
      ;;
    status | "")
      local ch='(none)'
      if [[ -f "$AUTOUPDATE_ENV" ]]; then
        ch="$(grep -E '^AUTOUPDATE_CHANNEL=' "$AUTOUPDATE_ENV" 2>/dev/null | head -1 | cut -d= -f2- || echo '(none)')"
      fi
      echo "Config:  ${AUTOUPDATE_ENV}"
      echo "Channel: ${ch}"
      if command -v systemctl >/dev/null 2>&1; then
        systemctl is-enabled jheffmedia-autoupdate.timer 2>/dev/null || echo "timer: disabled/missing"
        systemctl list-timers jheffmedia-autoupdate.timer --no-pager 2>/dev/null || true
      fi
      ;;
    *)
      echo "Unknown autoupdate action: ${action} (enable|disable|status)" >&2
      usage
      exit 1
      ;;
  esac
}

# Shared repair path for --cleanup and --reinstall.
run_cleanup() {
  local dry=${1:-0}
  local do_docker_prune=${2:-1}
  local unit=/etc/systemd/system/site.service
  local f

  if [[ "$dry" -eq 1 ]]; then
    echo "=== cleanup (dry-run) ==="
  else
    echo "=== cleanup ==="
  fi

  # 1) Legacy cred dumps
  if [[ -f "${COMPOSE_DIR}/lib/deploy.sh" ]]; then
    source_deploy
  fi
  if declare -F legacy_creds_paths >/dev/null 2>&1; then
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      if [[ -f "$f" ]]; then
        if [[ "$dry" -eq 1 ]]; then
          report would "remove ${f}"
        else
          rm -f "$f"
          report fixed "removed ${f}"
        fi
      else
        report skip "no ${f}"
      fi
    done < <(legacy_creds_paths)
  else
    for f in /root/site-install.creds "${HOME}/site-install.creds" \
      "${INSTALL_DIR}/site-install.creds" "${INSTALL_DIR}/install/site-install.creds"; do
      if [[ -f "$f" ]]; then
        if [[ "$dry" -eq 1 ]]; then
          report would "remove ${f}"
        else
          rm -f "$f"
          report fixed "removed ${f}"
        fi
      else
        report skip "no ${f}"
      fi
    done
  fi

  # 2) Service user (root)
  if [[ ${EUID:-0} -ne 0 ]]; then
    report skip "service user / perms / systemd (need root)"
  else
    if id -u "$SERVICE_USER" >/dev/null 2>&1; then
      report skip "user ${SERVICE_USER} exists (uid $(id -u "$SERVICE_USER"))"
      if getent group docker >/dev/null 2>&1; then
        if id -nG "$SERVICE_USER" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
          report skip "${SERVICE_USER} already in docker group"
        elif [[ "$dry" -eq 1 ]]; then
          report would "usermod -aG docker ${SERVICE_USER}"
        else
          usermod -aG docker "$SERVICE_USER"
          report fixed "added ${SERVICE_USER} to docker group"
        fi
      fi
    elif [[ "$dry" -eq 1 ]]; then
      report would "create ${SERVICE_USER} (uid ${SERVICE_UID} if free)"
    else
      if declare -F ensure_service_user >/dev/null 2>&1; then
        ensure_service_user
      else
        useradd --system --uid "$SERVICE_UID" --home-dir "$INSTALL_DIR" --no-create-home \
          --shell /usr/sbin/nologin "$SERVICE_USER"
        getent group docker >/dev/null 2>&1 && usermod -aG docker "$SERVICE_USER" || true
      fi
      report fixed "ensured service user ${SERVICE_USER}"
    fi

    # 3) Ownership / secret perms
    if [[ -d "$INSTALL_DIR" ]]; then
      if [[ "$dry" -eq 1 ]]; then
        report would "chown -R ${SERVICE_USER}:${SERVICE_USER} ${INSTALL_DIR}"
        [[ -f "$ENV_FILE" ]] && report would "chmod 600 ${ENV_FILE}"
        [[ -f "${INSTALL_DIR}/backend/src/secret.key" ]] && \
          report would "chmod 400 ${INSTALL_DIR}/backend/src/secret.key"
      else
        if declare -F harden_install_perms >/dev/null 2>&1; then
          COMMON_DIR="$COMPOSE_DIR" harden_install_perms
        else
          chown -R "${SERVICE_USER}:${SERVICE_USER}" "$INSTALL_DIR" 2>/dev/null || true
          [[ -f "$ENV_FILE" ]] && chmod 600 "$ENV_FILE" && chown "${SERVICE_USER}:${SERVICE_USER}" "$ENV_FILE"
          local key="${INSTALL_DIR}/backend/src/secret.key"
          [[ -f "$key" ]] && chmod 400 "$key" && chown "${SERVICE_USER}:${SERVICE_USER}" "$key"
        fi
        report fixed "ownership/perms on ${INSTALL_DIR}"
      fi
    else
      report skip "install tree missing (${INSTALL_DIR})"
    fi

    # 4) site.service User=
    if [[ -f "$unit" ]]; then
      if grep -qE "^User=${SERVICE_USER}$" "$unit"; then
        report skip "site.service already User=${SERVICE_USER}"
      elif [[ "$dry" -eq 1 ]]; then
        report would "rewrite site.service User=${SERVICE_USER}"
      else
        if [[ -f "$ENV_FILE" ]]; then
          # shellcheck disable=SC1091
          set -a
          # shellcheck disable=SC1090
          source "$ENV_FILE"
          set +a
        fi
        export HTTP_PORT="${HTTP_PORT:-8080}" HTTP_BIND="${HTTP_BIND:-0.0.0.0}"
        if [[ -d "${INSTALL_DIR}/scripts/lib" ]]; then
          container_bin 2>/dev/null || CONTAINER_BIN=docker
        else
          CONTAINER_BIN=docker
        fi
        export CONTAINER_BIN
        install_systemd
        report fixed "site.service User=${SERVICE_USER}"
      fi
    else
      report skip "no site.service"
    fi
  fi

  # 5) Project docker prune (exited containers only)
  if [[ "$do_docker_prune" -eq 1 ]]; then
    if [[ "$dry" -eq 1 ]]; then
      if declare -F cleanup_project_docker >/dev/null 2>&1; then
        cleanup_project_docker 1
      fi
    else
      if confirm "Prune exited jheffmedia containers (not volumes)?"; then
        if declare -F cleanup_project_docker >/dev/null 2>&1; then
          # Need CONTAINER_BIN if available
          if [[ -z "${CONTAINER_BIN:-}" ]] && [[ -d "${INSTALL_DIR}/scripts/lib" ]]; then
            container_bin 2>/dev/null || true
          fi
          cleanup_project_docker 0
          report fixed "project docker prune attempted"
        fi
      else
        report skip "project docker prune (declined)"
      fi
    fi
  fi

  echo "=== cleanup done (data / .env.production preserved) ==="
}

cmd_cleanup() {
  local dry=0
  ASSUME_YES=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      --dry-run) dry=1; shift ;;
      -y | --yes) ASSUME_YES=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done

  require_operator
  # Prefer on-disk libs when tree exists; else curl is not required for creds-only.
  if [[ -f "${COMPOSE_DIR}/lib/deploy.sh" ]]; then
    source_deploy
  fi
  run_cleanup "$dry" 1
}

purge_project_stack() {
  local dry=${1:-0}
  require_operator

  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing ${ENV_FILE} — cannot compose down; remove containers by name if needed." >&2
  else
    container_bin
    load_env
    cd "$COMPOSE_DIR"
    if [[ "$dry" -eq 1 ]]; then
      report would "compose down (containers; keep volumes)"
    else
      "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production down --remove-orphans || true
      report fixed "compose down"
    fi
  fi

  local bin="${CONTAINER_BIN:-docker}"
  if command -v "$bin" >/dev/null 2>&1; then
    local imgs
    imgs="$("$bin" images -q "jheffmedia/application" 2>/dev/null || true)"
    if [[ -n "$imgs" ]]; then
      if [[ "$dry" -eq 1 ]]; then
        report would "rmi jheffmedia/application images"
      else
        # shellcheck disable=SC2086
        "$bin" rmi $imgs 2>/dev/null || true
        report fixed "removed jheffmedia/application images"
      fi
    else
      report skip "no jheffmedia/application images"
    fi

    if confirm_volumes "DELETE named volumes jheffmedia-mongo + jheffmedia-content-uploads (DESTROYS DB/uploads)?"; then
      if [[ "$dry" -eq 1 ]]; then
        report would "docker volume rm jheffmedia-mongo jheffmedia-content-uploads (+ project prefixes)"
      else
        local v
        for v in jheffmedia-mongo jheffmedia-content-uploads \
          common_jheffmedia-mongo common_jheffmedia-content-uploads; do
          if "$bin" volume inspect "$v" >/dev/null 2>&1; then
            "$bin" volume rm "$v" && report fixed "removed volume ${v}" || \
              report skip "could not remove volume ${v}"
          fi
        done
      fi
    else
      report skip "named volumes preserved"
    fi
  fi
}

cmd_reinstall() {
  local no_cache=0 purge=0 dry=0
  ASSUME_YES=0
  # Match --update: default prod main unless -d/--branch.
  BRANCH="$CHANNEL_PROD"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      --branch) BRANCH="${2:?}"; shift 2 ;;
      --branch=*) BRANCH="${1#*=}"; shift ;;
      -d | --dev | --testing) BRANCH="$CHANNEL_DEV"; shift ;;
      --channel)
        BRANCH="$(resolve_channel "${2:?}")" || exit 1
        shift 2
        ;;
      --channel=*)
        BRANCH="$(resolve_channel "${1#*=}")" || exit 1
        shift
        ;;
      --no-cache) no_cache=1; shift ;;
      --purge) purge=1; shift ;;
      --dry-run) dry=1; shift ;;
      -y | --yes) ASSUME_YES=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done

  require_operator
  require_install_tree

  if [[ ! -d "${INSTALL_DIR}/.git" ]]; then
    echo "No git checkout at ${INSTALL_DIR}. Re-run the platform installer." >&2
    exit 1
  fi
  if [[ ! -f "$ENV_FILE" ]]; then
    echo "Missing ${ENV_FILE}. Re-run the platform installer (cleanup alone cannot invent secrets)." >&2
    exit 1
  fi

  if [[ "$dry" -eq 0 ]]; then
    if ! confirm "Reinstall stack at ${INSTALL_DIR} (pull ${BRANCH}, rebuild)?"; then
      echo "Aborted."
      exit 0
    fi
  fi

  if [[ -f "${COMPOSE_DIR}/lib/deploy.sh" ]]; then
    source_deploy
  fi

  # Skip docker prune inside cleanup when --purge will tear the stack down.
  run_cleanup "$dry" $((1 - purge))

  if [[ "$purge" -eq 1 ]]; then
    echo "=== purge (project only) ==="
    purge_project_stack "$dry"
  fi

  if [[ "$dry" -eq 1 ]]; then
    report would "git pull ${BRANCH}, compose build, up -d, postinstall"
    echo "=== reinstall dry-run done ==="
    return 0
  fi

  # Same rebuild path as --update (--branch keeps explicit channel)
  local update_args=(--branch "$BRANCH")
  [[ "$no_cache" -eq 1 ]] && update_args+=(--no-cache)
  cmd_update "${update_args[@]}"

  if [[ -x "$POSTINSTALL" ]]; then
    INSTALL_DIR="$INSTALL_DIR" "$POSTINSTALL" || true
  fi
  echo "[OK] Reinstall finished — http://127.0.0.1:${HTTP_PORT:-8080}/"
}

cmd_status() {
  require_install
  container_bin
  load_env
  if [[ -f "${COMPOSE_DIR}/lib/deploy.sh" ]]; then
    source_deploy 2>/dev/null || true
  fi
  local branch commit
  if declare -F install_git >/dev/null 2>&1; then
    branch="$(install_git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    commit="$(install_git rev-parse --short HEAD 2>/dev/null || echo '?')"
  else
    branch="$(git -c "safe.directory=${INSTALL_DIR}" -C "$INSTALL_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    commit="$(git -c "safe.directory=${INSTALL_DIR}" -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  fi
  echo "Install: ${INSTALL_DIR}"
  echo "User:    ${SERVICE_USER} (host); app container uid 10001"
  echo "Branch:  ${branch}"
  echo "Commit:  ${commit}"
  echo "Listen:  ${HTTP_BIND}:${HTTP_PORT} (host publish; app binds 0.0.0.0 in-container)"
  if [[ "${HTTP_BIND}" == "127.0.0.1" || "${HTTP_BIND}" == "localhost" ]]; then
    echo "[!!] HTTP_BIND=${HTTP_BIND} — only reachable on this LXC. Set HTTP_BIND=0.0.0.0 in .env.production for LAN access."
  fi
  systemctl is-active site 2>/dev/null || true
  cd "$COMPOSE_DIR"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production ps
  "$CONTAINER_BIN" port jheffmedia-application 8080 2>/dev/null || true
  "$CONTAINER_BIN" exec jheffmedia-application printenv YEW_FULLSTACK_HOST 2>/dev/null \
    | sed 's/^/YEW_FULLSTACK_HOST=/' || true
  local hz
  hz="$(curl -fsS --max-time 3 "http://127.0.0.1:${HTTP_PORT}/healthz" 2>/dev/null || true)"
  if [[ "$hz" == *'"ok":true'* || "$hz" == *'"ok": true'* ]]; then
    echo "healthz: ok"
  else
    echo "[!!] healthz failed (${hz:-no response}) — Mongo auth/conn often wrong."
    echo "      Check: docker logs jheffmedia-application --tail 40 | grep -i signup"
    echo "      Password vs volume: see docs/deployment.md § Signup fails"
  fi
}

cmd_restart() {
  require_operator
  require_install
  container_bin
  load_env
  cd "$COMPOSE_DIR"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production up -d --remove-orphans
  if [[ ${EUID:-0} -eq 0 ]]; then
    systemctl restart site 2>/dev/null || true
  fi
  echo "[OK] Restarted — http://127.0.0.1:${HTTP_PORT}/"
}

mongo_volume_names() {
  local bin="${CONTAINER_BIN:-docker}"
  # Any compose project prefix: common_jheffmedia-mongo, install_jheffmedia-mongo, …
  "$bin" volume ls -q 2>/dev/null | grep -E 'jheffmedia-mongo$' || true
}

cmd_diagnostics() {
  require_operator
  require_install
  container_bin
  load_env
  cd "$COMPOSE_DIR"

  if [[ -f "${COMPOSE_DIR}/lib/deploy.sh" ]]; then
    source_deploy 2>/dev/null || true
  fi
  local commit='?'
  if declare -F install_git >/dev/null 2>&1; then
    commit="$(install_git rev-parse --short HEAD 2>/dev/null || echo '?')"
  else
    commit="$(git -c "safe.directory=${INSTALL_DIR}" -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
  fi
  echo "=== jheffmedia diagnostics ==="
  echo "Install: ${INSTALL_DIR}"
  echo "Commit:  ${commit}"
  echo "Listen:  ${HTTP_BIND:-0.0.0.0}:${HTTP_PORT:-8080}"
  echo
  echo "--- compose ps ---"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production ps || true
  echo
  echo "--- /healthz ---"
  local hz
  hz="$(curl -fsS --max-time 5 "http://127.0.0.1:${HTTP_PORT}/healthz" 2>/dev/null || echo FAIL)"
  echo "$hz"
  if [[ "$hz" != *'"ok":true'* && "$hz" != *'"ok": true'* ]]; then
    echo "[!!] healthz not ok — often MONGO_PASSWORD ≠ volume (use --reset-db or fix env)."
  fi
  echo
  echo "--- app env (non-secret) ---"
  "$CONTAINER_BIN" exec jheffmedia-application printenv \
    YEW_FULLSTACK_HOST YEW_FULLSTACK_PORT YEW_FULLSTACK_DB_NAME YEW_FULLSTACK_BUILD_ID \
    YEW_FULLSTACK_FEED_PROVIDER RUST_LOG 2>/dev/null || echo "(app container not running)"
  echo
  echo "--- db health / logs ---"
  "$CONTAINER_BIN" inspect jheffmedia-database --format 'health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} status={{.State.Status}}' 2>/dev/null || echo "(no db container)"
  "$CONTAINER_BIN" logs --tail 40 jheffmedia-database 2>/dev/null || true
  echo
  echo "--- mongo auth ping (inside db container) ---"
  if [[ -n "${MONGO_PASSWORD:-}" ]]; then
    if "$CONTAINER_BIN" exec jheffmedia-database mongosh -u root -p "$MONGO_PASSWORD" \
      --authenticationDatabase admin --quiet --eval 'quit(db.adminCommand({ping:1}).ok ? 0 : 1)' 2>/dev/null; then
      echo "mongo: auth ping ok"
    else
      echo "[!!] mongo: auth ping FAILED."
      if "$CONTAINER_BIN" logs jheffmedia-database 2>/dev/null | grep -q 'Could not find user \"root\"'; then
        echo "      Logs show UserNotFound root — volume was inited without MONGO_INITDB_* (or wrong env prefix)."
      fi
      echo "      Fix: jheffmedia --update && jheffmedia --reset-db   # need compose with MONGO_INITDB_* then wipe"
    fi
  else
    echo "[!!] MONGO_PASSWORD not loaded from .env.production"
  fi
  echo
  echo "--- compose db env (names only) ---"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production config 2>/dev/null \
    | grep -E 'MONGO_INITDB_|MONGODB_INITDB_|MONGO_PASSWORD:' || true
  echo
  echo "--- recent app log (signup / auth) ---"
  "$CONTAINER_BIN" logs --tail 30 jheffmedia-application 2>/dev/null \
    | grep -iE 'signup|auth|mongo|error|DATABASE' || echo "(no matching lines / app not up)"
  echo
  echo "Admin → Dev on the site shows dbTests + production warnings after signup."
}

cmd_reset_db() {
  ASSUME_YES=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      -y | --yes) ASSUME_YES=1; shift ;;
      *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
  done

  require_operator
  require_install
  container_bin
  load_env
  cd "$COMPOSE_DIR"

  if [[ -z "${MONGO_PASSWORD:-}" ]]; then
    echo "[!!] MONGO_PASSWORD empty in .env.production — refuse wipe (init would skip root user)." >&2
    exit 1
  fi
  echo "MONGO_PASSWORD length: ${#MONGO_PASSWORD} (value not printed)"

  # Warn if on-disk compose still has the wrong prefix (pre-fix tree).
  if grep -q 'MONGODB_INITDB_ROOT' docker-compose.yml 2>/dev/null; then
    echo "[!!] docker-compose.yml still uses MONGODB_INITDB_* (ignored by official mongo image)."
    echo "     Run: jheffmedia --update   then re-run --reset-db"
    exit 1
  fi
  if ! grep -q 'MONGO_INITDB_ROOT_PASSWORD' docker-compose.yml 2>/dev/null; then
    echo "[!!] docker-compose.yml missing MONGO_INITDB_ROOT_PASSWORD — update the install tree first." >&2
    exit 1
  fi

  echo "This DELETES Mongo data (users, schedule, site_config)."
  echo "Keeps: content uploads volume, .env.production, JWT secret."
  echo "New empty DB will create user root via MONGO_INITDB_* + MONGO_PASSWORD."
  local ans=
  if [[ "${JM_RESET_DB:-}" == "yes" ]]; then
    ans=RESET
  elif [[ "${ASSUME_YES:-0}" -eq 1 ]]; then
    read -r -p "Type RESET to confirm: " ans || true
  else
    read -r -p "Type RESET to wipe Mongo volume: " ans || true
  fi
  if [[ "$ans" != "RESET" ]]; then
    echo "Aborted."
    exit 1
  fi

  echo "[..] force-removing containers"
  "$CONTAINER_BIN" rm -f jheffmedia-application jheffmedia-database 2>/dev/null || true
  echo "[..] compose down"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production down --remove-orphans || true

  echo "[..] mongo volumes before wipe:"
  mongo_volume_names | sed 's/^/  /' || echo "  (none)"
  local v removed=0
  while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    if "$CONTAINER_BIN" volume rm -f "$v"; then
      echo "[fixed] removed volume ${v}"
      removed=$((removed + 1))
    else
      echo "[!!] could not remove volume ${v}" >&2
    fi
  done < <(mongo_volume_names | awk 'NF && !seen[$0]++')
  echo "[..] mongo volumes after wipe:"
  mongo_volume_names | sed 's/^/  /' || echo "  (none)"
  if [[ "$removed" -eq 0 ]]; then
    echo "[..] no named mongo volumes removed (ok if first boot); compose will create a fresh one"
  fi

  echo "[..] starting db only (watch for init)"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production up -d db
  local i health='starting'
  for i in $(seq 1 60); do
    health="$("$CONTAINER_BIN" inspect jheffmedia-database --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' 2>/dev/null || echo missing)"
    echo "  … db health=${health} (${i}s)"
    [[ "$health" == "healthy" ]] && break
    [[ "$health" == "unhealthy" && "$i" -gt 25 ]] && break
    sleep 2
  done
  if [[ "$health" != "healthy" ]]; then
    echo "[!!] db not healthy after wipe — last logs:" >&2
    "$CONTAINER_BIN" logs --tail 60 jheffmedia-database >&2 || true
    echo "Inspect: docker compose … config | grep MONGO_INITDB" >&2
    exit 1
  fi

  echo "[..] starting full stack"
  "$CONTAINER_BIN" compose -f docker-compose.yml --env-file .env.production up -d --remove-orphans
  echo "[OK] Mongo reset + healthy. Sign up again with:"
  grep -E '^ADMIN_EMAILS=' "$ENV_FILE" 2>/dev/null || true
  echo "Then: jheffmedia --diagnostics"
}

cmd_postinstall() {
  require_install
  if [[ ! -x "$POSTINSTALL" ]]; then
    echo "Missing ${POSTINSTALL}" >&2
    exit 1
  fi
  INSTALL_DIR="$INSTALL_DIR" "$POSTINSTALL" "$@"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    --update | update)
      cmd_update "$@"
      ;;
    --autoupdate | autoupdate)
      cmd_autoupdate "$@"
      ;;
    --cleanup | cleanup)
      cmd_cleanup "$@"
      ;;
    --reinstall | reinstall)
      cmd_reinstall "$@"
      ;;
    --status | status) cmd_status ;;
    --diagnostics | diagnostics) cmd_diagnostics ;;
    --reset-db | reset-db) cmd_reset_db "$@" ;;
    --restart | restart) cmd_restart ;;
    --postinstall | postinstall) cmd_postinstall "$@" ;;
    -h | --help | help | "") usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
