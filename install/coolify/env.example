# Coolify → Dockerfile-only. Set these as environment variables on the app.
# MongoDB is a separate Coolify service (or any reachable Mongo). Point DB_CONNSTR at it.

YEW_FULLSTACK_HOST=0.0.0.0
YEW_FULLSTACK_PORT=8080
YEW_FULLSTACK_DB_NAME=jheffmedia
# Replace host `mongo` with your Coolify Mongo service hostname / internal URL.
YEW_FULLSTACK_DB_CONNSTR=mongodb://root:CHANGE_ME@mongo:27017/jheffmedia?authSource=admin

# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
YEW_FULLSTACK_JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

YEW_FULLSTACK_FEED_PROVIDER=static
YEW_FULLSTACK_FEED_STATIC_JSON=[{"id":"1","thumbnailUrl":"https://picsum.photos/seed/auto1/800/600","title":"Track still","mediaType":"image"},{"id":"2","thumbnailUrl":"https://picsum.photos/seed/auto2/800/600","title":"Garage detail","mediaType":"image"}]

YEW_FULLSTACK_ADMIN_EMAILS=you@example.com
YEW_FULLSTACK_CORS_ORIGINS=https://your.coolify.domain
YEW_FULLSTACK_CONTENT_UPLOAD_DIR=/data/content-uploads

# Optional Immich later:
# YEW_FULLSTACK_FEED_PROVIDER=immich
# YEW_FULLSTACK_IMMICH_URL=https://immich.example.com
# YEW_FULLSTACK_IMMICH_API_KEY=
# YEW_FULLSTACK_IMMICH_ALBUM_ID=
