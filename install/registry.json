{
  "version": 1,
  "source": "https://github.com/jjheffernan/jheff.media-site",
  "documentation": "https://github.com/jjheffernan/jheff.media-site/blob/main/docs/deployment.md",
  "notes": [
    "Catalog entry in the spirit of community-scripts.org — one app, several host targets.",
    "Not a Cloudflare Workers project. Deploy with Docker via the install targets below.",
    "Production branch is main. Install scripts still accept BRANCH=dev for staging."
  ],
  "apps": [
    {
      "slug": "jheffmedia",
      "name": "jheff.media",
      "type": "container",
      "description": "Automotive photography site — Yew WASM frontend, Actix API, MongoDB. Admin content browser, Immich/Nextcloud import, contact and booking.",
      "website": "https://jheff.media",
      "documentation": "https://github.com/jjheffernan/jheff.media-site/blob/main/docs/deployment.md",
      "source": "https://github.com/jjheffernan/jheff.media-site",
      "license": "MIT",
      "tags": ["media", "photography", "docker", "actix", "yew"],
      "categories": ["media", "web"],
      "default_branch": "main",
      "resources": {
        "cpu": 2,
        "ram_mb": 6144,
        "disk_gb": 24,
        "os": "debian",
        "os_version": "13",
        "unprivileged": true
      },
      "ports": [
        {
          "port": 8080,
          "protocol": "tcp",
          "description": "HTTP — put Caddy, Nginx, or a Cloudflare Tunnel in front for TLS"
        }
      ],
      "services": [
        { "name": "application", "image": "jheffmedia/application:latest", "role": "Actix + baked Yew frontend" },
        { "name": "db", "image": "mongo:7.0", "role": "MongoDB (bundled)" }
      ],
      "install": {
        "proxmox": {
          "script": "install/proxmox/ct/jheffmedia.sh",
          "install_script": "install/proxmox/install/jheffmedia-install.sh",
          "entry": "install/proxmox/install.sh",
          "command": "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/jjheffernan/jheff.media-site/main/install/proxmox/install.sh)\"",
          "engine": "https://raw.githubusercontent.com/community-scripts/core/main/core/build.func",
          "template_fallback": "https://raw.githubusercontent.com/community-scripts/ProxmoxVE/main/ct/debian.sh"
        },
        "baremetal": {
          "entry": "install/baremetal/install.sh",
          "command": "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/jjheffernan/jheff.media-site/main/install/baremetal/install.sh)\""
        },
        "truenas": {
          "entry": "install/truenas/install.sh",
          "command": "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/jjheffernan/jheff.media-site/main/install/truenas/install.sh)\""
        },
        "coolify": {
          "dockerfile": "Dockerfile",
          "mirror_script": "install/coolify/mirror.sh",
          "env_example": "install/coolify/env.example",
          "readme": "install/coolify/README.md",
          "notes": "Dockerfile-only. Local bare git mirror for self-hosted Coolify without GitHub. MongoDB is a separate Coolify service."
        }
      },
      "credentials_path": "/root/site-install.creds",
      "env_file": "install/common/.env.production",
      "compose": "install/common/docker-compose.yml",
      "update": {
        "cli": "install/common/bin/jheffmedia",
        "command": "jheffmedia --update",
        "curl": "bash -c \"$(curl -fsSL https://raw.githubusercontent.com/jjheffernan/jheff.media-site/main/install/update.sh)\"",
        "local": "/usr/local/bin/jheffmedia"
      }
    }
  ],
  "targets": [
    {
      "id": "proxmox",
      "name": "Proxmox VE",
      "kind": "lxc",
      "readme": "install/proxmox/README.md",
      "entry": "install/proxmox/install.sh",
      "notes": "Uses community-scripts Core (core/build.func). Layout: install/proxmox/{ct,install}/. Or create a Debian template LXC first, then MODE=existing."
    },
    {
      "id": "baremetal",
      "name": "Bare metal (Debian/Ubuntu)",
      "kind": "host",
      "readme": "install/baremetal/README.md",
      "entry": "install/baremetal/install.sh",
      "notes": "Requires root and Docker (or installs Docker during setup)."
    },
    {
      "id": "truenas",
      "name": "TrueNAS SCALE",
      "kind": "host",
      "readme": "install/truenas/README.md",
      "entry": "install/truenas/install.sh",
      "notes": "Shell install or Custom App pointing at install/common/docker-compose.yml."
    },
    {
      "id": "coolify",
      "name": "Coolify (Dockerfile)",
      "kind": "paas",
      "readme": "install/coolify/README.md",
      "entry": "install/coolify/mirror.sh",
      "notes": "Local git mirror + root Dockerfile. MongoDB separate. Env: install/coolify/env.example."
    }
  ]
}
