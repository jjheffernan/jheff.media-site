# Copy to scripts/config/dev.env.local (gitignored) and fill in.
# Sourced after scripts/config/dev.env by scripts/dev.sh — overrides win.
#
# Prefer Admin → Setup (paste Immich URL/key/album → Save) once the app is up;
# Mongo site_config overrides env. Use this file for bootstrap + scripts/smoke.sh
# “demand Immich” checks before/without Admin save.
#
# Never commit real URL/key/album values.

export YEW_FULLSTACK_FEED_PROVIDER=immich
export YEW_FULLSTACK_IMMICH_URL=https://photos.example.com
export YEW_FULLSTACK_IMMICH_API_KEY=
export YEW_FULLSTACK_IMMICH_ALBUM_ID=
# export YEW_FULLSTACK_IMMICH_SHARED_KEY=
